{
  "name": "jobsite2",
  "version": "1.0.0",
  "private": true,
  "description": "موقع وظائف شركة الرافدين — نظام الرتب والسجلات بقاعدة بيانات جاهزة للربط مع سيرفر بايثون",
  "scripts": {
    "start": "python3 -m http.server 8000",
    "test": "node tests/smoke.test.mjs && node tests/api.test.mjs",
    "test:local": "node tests/smoke.test.mjs",
    "test:api": "node tests/api.test.mjs",
    "db:init": "python3 -c \"import sqlite3,io;c=sqlite3.connect('jobsite.db');c.executescript(open('db/schema.sql',encoding='utf-8').read());c.executescript(open('db/seed.sql',encoding='utf-8').read());print('jobsite.db جاهزة')\"",
    "test:e2e": "node tests/e2e.test.mjs",
    "server": "cd server && uvicorn app:app --reload --host 0.0.0.0 --port 8010"
  },
  "devDependencies": {
    "jsdom": "^30.0.1"
  }
}
